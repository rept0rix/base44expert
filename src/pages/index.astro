---
import Layout from '../layouts/Layout.astro'
import ChangelogFeed from '../components/ChangelogFeed.astro'
import FaqList from '../components/FaqList.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Base44 Expert',
  url: 'https://base44expert.com',
  description:
    'Independent specialist studio that unsticks stuck Base44 apps: publish errors, custom domains, schema mismatches, and production blockers.',
  email: 'na0ryank0@gmail.com',
  areaServed: 'Worldwide',
  knowsAbout: [
    'Base44',
    'Base44 publish errors',
    'Base44 custom domains',
    'Base44 entity schemas',
    'Base44 production debugging',
  ],
  sameAs: ['https://fixthebase.com'],
}

const faqTeaser = [
  {
    question: 'Are you affiliated with Base44 or Wix?',
    answer:
      'No. Base44 Expert is an independent studio. For platform outages, check <a href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a> and the official docs.',
  },
  {
    question: 'Do you build new Base44 apps from scratch?',
    answer:
      'No. We unstick existing apps - publish, domains, data, production. We do not sell greenfield builds as a productized service.',
  },
  {
    question: 'How do I start?',
    answer:
      'Use the <a href="/start">diagnostic form</a>. It opens your email client with a structured case to na0ryank0@gmail.com - no third-party form backend.',
  },
]

const unstick = [
  {
    tag: 'Publish',
    title: 'Deploy said success. Live did not move.',
    body: 'Build failed, blank screen after publish, or a stale live URL. We start with status, then logs.',
    href: '/base44-not-working',
    flip: false,
  },
  {
    tag: 'Domains',
    title: 'Works on Base44. Breaks on yours.',
    body: 'DNS, Cloudflare proxy, certificate still pending. Custom domain stuck in limbo.',
    href: '/custom-domains',
    flip: true,
  },
  {
    tag: 'Data',
    title: 'Schema drifted after an AI edit.',
    body: 'Records missing, validation errors you cannot trace, entity fields that no longer match production.',
    href: null,
    flip: false,
    wide: true,
  },
  {
    tag: 'Live vs preview',
    title: 'Fine in preview. Dead in production.',
    body: 'Connectors, env, assets, or auth that only fail once the app is live.',
    href: null,
    flip: true,
  },
]
---

<Layout
  title="Base44 Expert - Unstick stuck Base44 apps"
  description="Specialist studio for Base44 publish errors, custom domain SSL, schema mismatches, and preview-vs-production blockers. Start a diagnostic."
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Hero: molten mark drips, reforms into wordmark -->
    <section class="hero-melt" aria-labelledby="hero-heading">
      <div class="melt-stage" aria-hidden="true">
        <img class="melt-blob" src="/logo-melt.svg" alt="" width="280" height="326" />
        <div class="melt-drip"></div>
        <p class="melt-wordmark">Base44 <span>Expert</span></p>
      </div>

      <div class="hero-content max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl text-ink max-w-3xl text-balance mb-5 leading-[1.05]">
          Stuck Base44 apps thaw under heat.
        </h1>
        <p class="text-lg sm:text-xl text-muted max-w-xl leading-relaxed mb-8">
          Publish lies. Domains stall. Schema drifts. We find the fault line and fix it.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/start" class="btn-primary">Start a diagnostic</a>
          <a href="/work" class="btn-secondary">See the process</a>
        </div>
      </div>
    </section>

    <!-- What we unstick: asymmetric zig-zag, not 3 equal cards -->
    <section class="section-padding border-t border-line" aria-labelledby="unstick-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="unstick-heading" class="text-3xl sm:text-4xl text-ink mb-12 max-w-2xl">
          What we unstick
        </h2>
        <div class="flex flex-col gap-6 md:gap-8">
          {unstick.map((row) => (
            row.href ? (
              <a href={row.href} class={`unstick-row${row.flip ? ' is-flip' : ''}${row.wide ? ' is-wide' : ''}`}>
                <div class="unstick-meta">
                  <span class="unstick-tag">{row.tag}</span>
                  <h3 class="font-display text-2xl sm:text-3xl text-ink leading-tight">{row.title}</h3>
                </div>
                <p class="text-muted leading-relaxed max-w-prose">{row.body}</p>
              </a>
            ) : (
              <div class={`unstick-row${row.flip ? ' is-flip' : ''}${row.wide ? ' is-wide' : ''}`}>
                <div class="unstick-meta">
                  <span class="unstick-tag">{row.tag}</span>
                  <h3 class="font-display text-2xl sm:text-3xl text-ink leading-tight">{row.title}</h3>
                </div>
                <p class="text-muted leading-relaxed max-w-prose">{row.body}</p>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <ChangelogFeed limit={5} />

    <!-- Process strip -->
    <section class="section-padding border-t border-line" aria-labelledby="method-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="method-heading" class="text-3xl sm:text-4xl text-ink mb-10">
          Diagnostic first. Then the fix.
        </h2>
        <div class="process-strip">
          {[
            { t: 'Intake', d: 'You describe the stuck moment, app URL, and last change.' },
            { t: 'Isolate', d: 'Status, logs, DNS, schema, connectors - find the real fault line.' },
            { t: 'Fix', d: 'Scoped change in place. No rebuild-everything by default.' },
            { t: 'Explain', d: 'What broke, why, and how to avoid the same trap next time.' },
          ].map((s) => (
            <div class="process-cell">
              <h3 class="font-display text-xl text-ink mb-2">{s.t}</h3>
              <p class="text-sm text-muted leading-relaxed">{s.d}</p>
            </div>
          ))}
        </div>
        <p class="mt-8">
          <a href="/work" class="text-sm text-accent hover:text-accent-2 underline underline-offset-2 transition-colors">Full process</a>
        </p>
      </div>
    </section>

    <!-- Blog teaser -->
    <section class="section-padding border-t border-line bg-bg-2" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 id="blog-heading" class="text-3xl sm:text-4xl text-ink">Latest notes</h2>
          <a href="/blog" class="text-sm text-muted hover:text-accent underline underline-offset-2 shrink-0 transition-colors">All posts</a>
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { href: '/blog/base44-not-working', title: 'Base44 not working: a calm triage order', d: 'Status first, then publish, domain, and schema.' },
            { href: '/blog/base44-publish-error', title: 'When publish says success but live is unchanged', d: 'Stale cache, failed build, wrong target.' },
            { href: '/blog/base44-custom-domain-ssl', title: 'Custom domain SSL still pending', d: 'DNS, proxy, and certificate timing.' },
            { href: '/blog/base44-changelog-what-changed', title: 'How to read the Base44 changelog', d: 'Product RSS, status, and what it means for stuck apps.' },
          ].map((p) => (
            <li>
              <a href={p.href} class="card-panel block h-full hover:border-accent/40 transition-colors group">
                <h3 class="font-display text-xl text-ink mb-2 group-hover:text-accent transition-colors">{p.title}</h3>
                <p class="text-sm text-muted">{p.d}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ teaser -->
    <section class="section-padding border-t border-line" aria-labelledby="faq-teaser-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-teaser-heading" class="text-3xl sm:text-4xl text-ink mb-8">Quick answers</h2>
        <FaqList items={faqTeaser} idPrefix="home-faq" />
        <p class="mt-6 text-sm">
          <a href="/faq" class="underline underline-offset-2 text-accent hover:text-accent-2 transition-colors">Full FAQ</a>
        </p>
      </div>
    </section>

    <!-- FixTheBase aside -->
    <section class="section-padding border-t border-line" aria-labelledby="fixthebase-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <aside class="glow-aside flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div>
            <h2 id="fixthebase-heading" class="text-3xl text-ink mb-2">FixTheBase</h2>
            <p class="text-muted max-w-xl text-sm leading-relaxed">
              A related Base44-oriented tool from the same builder. Studio rescue work stays on Base44 Expert;
              FixTheBase is a separate product surface.
            </p>
          </div>
          <a href="https://fixthebase.com" class="btn-secondary shrink-0" rel="noopener noreferrer" target="_blank">
            Visit FixTheBase
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </aside>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section-padding border-t border-line relative overflow-hidden" aria-labelledby="cta-heading">
      <div
        class="pointer-events-none absolute inset-0 opacity-60"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(255,106,0,0.18), transparent 60%);"
      ></div>
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="cta-heading" class="font-display text-3xl sm:text-4xl mb-4 text-ink">Ready to unstick it?</h2>
        <p class="text-muted mb-8 leading-relaxed max-w-prose mx-auto">
          Open a structured diagnostic email. No Formspree. No invented ticket queue - just a clear case for us to reply to.
        </p>
        <a href="/start" class="btn-primary">Start a diagnostic</a>
      </div>
    </section>
  </main>
</Layout>
