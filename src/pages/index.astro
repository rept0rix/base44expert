---
import Layout from '../layouts/Layout.astro'
import ChangelogFeed from '../components/ChangelogFeed.astro'
import FaqList from '../components/FaqList.astro'
import HeroMolten from '../components/HeroMolten.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Base44 Expert',
  url: 'https://base44expert.com',
  description:
    'Independent specialist studio that unsticks stuck Base44 apps: publish errors, custom domains, schema mismatches, and production blockers.',
  email: 'na0ryank0@gmail.com',
  areaServed: 'Worldwide',
  knowsAbout: [
    'Base44',
    'Base44 publish errors',
    'Base44 custom domains',
    'Base44 entity schemas',
    'Base44 production debugging',
  ],
  sameAs: ['https://fixthebase.com'],
}

const faqTeaser = [
  {
    question: 'Are you affiliated with Base44 or Wix?',
    answer:
      'No. Base44 Expert is an independent studio. For platform outages, check <a href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a> and the official docs.',
  },
  {
    question: 'Do you build new Base44 apps from scratch?',
    answer:
      'No. We unstick existing apps - publish, domains, data, production. We do not sell greenfield builds as a productized service.',
  },
  {
    question: 'How do I start?',
    answer:
      'Use the <a href="/start">diagnostic form</a>. It opens your email client with a structured case to na0ryank0@gmail.com - no third-party form backend.',
  },
]

const warRoom = [
  {
    symptom: 'Publish button green. Live URL still yesterday.',
    fault: 'Stale artifact, wrong publish target, or CDN holding the old build.',
    move: 'Diff the live HTML hash vs the editor preview. Check status. Then logs — not a full redesign.',
    viz: '/viz/fault-publish.svg',
    href: '/base44-not-working',
  },
  {
    symptom: 'Custom domain stuck on “certificate pending”.',
    fault: 'DNS not authoritative, Cloudflare proxy orange, or CAA blocking issue.',
    move: 'Resolve A/CNAME first. Flatten proxy. Wait for issuance only after DNS answers correctly.',
    viz: '/viz/fault-domain.svg',
    href: '/custom-domains',
  },
  {
    symptom: 'AI edited an entity. Saves fail. Old records look haunted.',
    fault: 'Schema drift: required fields, types, or relations that production data never had.',
    move: 'Export sample records. Diff schema versions. Patch fields or migrate data — do not guess in the UI.',
    viz: '/viz/fault-schema.svg',
    href: null,
  },
  {
    symptom: 'Preview works. Production throws or blanks.',
    fault: 'Live-only connectors, missing secrets, auth redirect, or asset paths that only resolve in preview.',
    move: 'Compare env and connector bindings. Reproduce with production URL + hard refresh. Isolate before rewrite.',
    viz: '/viz/fault-preview.svg',
    href: null,
  },
]

const changelogTension = [
  {
    note: 'Platform ships a new publish path',
    risk: 'Your “success” toast may mean a different target than the URL you share with clients.',
  },
  {
    note: 'Domain / SSL tooling changes',
    risk: 'Pending certificates linger longer when DNS was “close enough” under the old flow.',
  },
  {
    note: 'Entity / AI builder updates',
    risk: 'Generated schema edits can invalidate validation on data you already collected.',
  },
]
---

<Layout
  title="Base44 Expert - Unstick stuck Base44 apps"
  description="Specialist desk for Base44 publish failures, custom domain SSL limbo, schema drift after AI edits, and preview-vs-production breaks. Concrete triage — start a diagnostic."
  jsonLd={jsonLd}
>
  <main id="main">
    <HeroMolten />

    <!-- War room: dense specialist intel (not equal feature cards) -->
    <section id="war-room" class="war-room" aria-labelledby="war-heading">
      <div class="war-room__inner max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="war-room__intro">
          <h2 id="war-heading" class="war-room__title">
            War room: what actually breaks in Base44
          </h2>
          <p class="war-room__lead">
            This is the desk view — symptoms we see, the fault underneath, and the first move.
            Soft “we help you build” copy does not belong here.
          </p>
        </div>

        <div class="war-room__layout">
          <figure class="war-room__diagram">
            <img
              src="/viz/war-room-triage.svg"
              alt="Triage ladder: status, publish, DNS/SSL, schema, connectors"
              width="720"
              height="420"
              loading="eager"
            />
            <figcaption class="war-room__caption">
              Stop at the first red rung. Rewriting the app before status + publish is how stuck apps stay stuck.
            </figcaption>
          </figure>

          <ol class="war-room__cases" role="list">
            {warRoom.map((row, i) => (
              <li class={`war-case${i % 2 === 1 ? ' is-offset' : ''}`}>
                <img class="war-case__viz" src={row.viz} alt="" width="200" height="125" loading="lazy" />
                <div class="war-case__body">
                  <p class="war-case__symptom">{row.symptom}</p>
                  <p class="war-case__fault"><span>Fault</span> {row.fault}</p>
                  <p class="war-case__move"><span>First move</span> {row.move}</p>
                  {row.href ? (
                    <a href={row.href} class="link-draw text-sm">Deeper note</a>
                  ) : null}
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="war-tension view-reveal">
          <h3 class="war-tension__title">Changelog tension</h3>
          <p class="war-tension__lead">
            Official Base44 notes are useful. They are not a diagnosis. Product ships; your app may still be stuck on an older assumption.
          </p>
          <ul class="war-tension__list" role="list">
            {changelogTension.map((t) => (
              <li>
                <strong>{t.note}</strong>
                <span>{t.risk}</span>
              </li>
            ))}
          </ul>
          <p class="war-tension__links">
            <a href="/updates" class="link-draw">Official updates we track</a>
            <span aria-hidden="true"> · </span>
            <a href="/blog/base44-changelog-what-changed" class="link-draw">How to read a changelog when you are stuck</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Scroll-scrub heat band -->
    <section class="scrub-sticky" aria-labelledby="scrub-heading">
      <div class="scrub-sticky__pin">
        <div class="scrub-orb" aria-hidden="true"></div>
        <div class="scrub-liquid" aria-hidden="true"></div>
        <div class="scrub-copy">
          <h2 id="scrub-heading" class="font-display text-3xl sm:text-5xl text-ink text-balance mb-4 leading-[1.08]">
            Heat finds the fault line.
          </h2>
          <p class="text-muted leading-relaxed">
            Status first. Then publish logs. Then DNS. Then schema. Then connectors.
            Isolate before you touch the UI.
          </p>
        </div>
      </div>
    </section>

    <ChangelogFeed limit={5} />

    <!-- Process: dense strip, not four equal marketing cards -->
    <section class="section-padding border-t border-line" aria-labelledby="method-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="method-heading" class="view-reveal text-3xl sm:text-4xl text-ink mb-4">
          Diagnostic first. Fix second. Explain always.
        </h2>
        <p class="text-muted max-w-2xl mb-10 leading-relaxed">
          You send the stuck moment, the app URL, and the last change. We return with the fault line named —
          not a vague “let’s hop on a call” pitch.
        </p>
        <div class="process-strip view-reveal-delay">
          {[
            { t: 'Intake', d: 'Stuck symptom, URL, last publish / AI edit / DNS change. Structured mailto — no form SaaS.' },
            { t: 'Isolate', d: 'Status → publish → DNS/SSL → schema → connectors. Stop at the first red rung.' },
            { t: 'Fix', d: 'Scoped change in place. We do not sell rebuild-everything as the default.' },
            { t: 'Explain', d: 'What broke, why, and the trap to avoid next time you touch that surface.' },
          ].map((s) => (
            <div class="process-cell">
              <h3 class="font-display text-xl text-ink mb-2">{s.t}</h3>
              <p class="text-sm text-muted leading-relaxed">{s.d}</p>
            </div>
          ))}
        </div>
        <p class="mt-8">
          <a href="/work" class="link-draw text-sm">Full process</a>
        </p>
      </div>
    </section>

    <!-- Notes: asymmetric, with imagery -->
    <section class="section-padding border-t border-line bg-bg-2" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 id="blog-heading" class="view-reveal text-3xl sm:text-4xl text-ink">Field notes worth reading</h2>
          <a href="/blog" class="link-draw text-sm text-muted shrink-0">All posts</a>
        </div>
        <ul class="home-notes" role="list">
          {[
            {
              href: '/blog/base44-not-working',
              title: 'Base44 not working: calm triage order',
              d: 'Status before panic. Publish before redesign. The order that saves hours.',
              img: '/blog/hero-not-working.svg',
              wide: true,
            },
            {
              href: '/blog/base44-publish-error',
              title: 'Publish said success. Live did not move.',
              d: 'Stale cache, failed build, wrong target — how to prove which.',
              img: '/blog/hero-publish-error.svg',
              wide: false,
            },
            {
              href: '/blog/base44-custom-domain-ssl',
              title: 'Custom domain SSL still pending',
              d: 'DNS, proxy, CAA, and why waiting without fixing names never works.',
              img: '/blog/hero-domain-ssl.svg',
              wide: false,
            },
            {
              href: '/blog/base44-changelog-what-changed',
              title: 'How to read the Base44 changelog when stuck',
              d: 'Product notes vs your fault line — what to extract, what to ignore.',
              img: '/blog/hero-changelog.svg',
              wide: true,
            },
          ].map((p) => (
            <li class={`home-notes__item${p.wide ? ' is-wide' : ''} view-reveal`}>
              <a href={p.href} class="home-notes__card">
                <img src={p.img} alt="" width="480" height="240" loading="lazy" />
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.d}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-padding border-t border-line" aria-labelledby="faq-teaser-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-teaser-heading" class="view-reveal text-3xl sm:text-4xl text-ink mb-8">Quick answers</h2>
        <FaqList items={faqTeaser} idPrefix="home-faq" />
        <p class="mt-6 text-sm">
          <a href="/faq" class="link-draw">Full FAQ</a>
        </p>
      </div>
    </section>

    <section class="section-padding border-t border-line" aria-labelledby="fixthebase-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <aside class="glow-aside flex flex-col md:flex-row md:items-center md:justify-between gap-6 view-reveal">
          <div>
            <h2 id="fixthebase-heading" class="text-3xl text-ink mb-2">FixTheBase</h2>
            <p class="text-muted max-w-xl text-sm leading-relaxed">
              A related Base44-oriented tool from the same builder. Studio rescue work stays on Base44 Expert;
              FixTheBase is a separate product surface.
            </p>
          </div>
          <a href="https://fixthebase.com" class="btn-secondary shrink-0" rel="noopener noreferrer" target="_blank">
            Visit FixTheBase
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </aside>
      </div>
    </section>

    <section class="section-padding border-t border-line relative overflow-hidden" aria-labelledby="cta-heading">
      <div
        class="parallax-glow pointer-events-none absolute inset-0 opacity-60"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(255,106,0,0.2), transparent 60%);"
      ></div>
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="cta-heading" class="view-reveal font-display text-3xl sm:text-4xl mb-4 text-ink">
          Send the stuck moment.
        </h2>
        <p class="text-muted mb-8 leading-relaxed max-w-prose mx-auto">
          App URL, what broke, last change. Structured diagnostic email — no Formspree, no invented ticket queue.
        </p>
        <a href="/start" class="btn-primary magnetic">Start a diagnostic</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  const supportsViewTimeline =
    typeof CSS !== 'undefined' &&
    typeof CSS.supports === 'function' &&
    CSS.supports('animation-timeline: view()')

  const reduce =
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!supportsViewTimeline && !reduce) {
    const targets = document.querySelectorAll('.view-reveal, .view-reveal-delay')
    if (targets.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-inview', '')
              io.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
      )
      targets.forEach((el) => io.observe(el))
    } else {
      targets.forEach((el) => el.setAttribute('data-inview', ''))
    }
  }
</script>
