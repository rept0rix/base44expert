---
import Layout from '../layouts/Layout.astro'
import ChangelogFeed from '../components/ChangelogFeed.astro'
import FaqList from '../components/FaqList.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Base44 Expert',
  url: 'https://base44expert.com',
  description:
    'Independent specialist studio that unsticks stuck Base44 apps: publish errors, custom domains, schema mismatches, and production blockers.',
  email: 'na0ryank0@gmail.com',
  areaServed: 'Worldwide',
  knowsAbout: [
    'Base44',
    'Base44 publish errors',
    'Base44 custom domains',
    'Base44 entity schemas',
    'Base44 production debugging',
  ],
  sameAs: ['https://fixthebase.com'],
}

const faqTeaser = [
  {
    question: 'Are you affiliated with Base44 or Wix?',
    answer:
      'No. Base44 Expert is an independent studio. For platform outages, check <a href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a> and the official docs.',
  },
  {
    question: 'Do you build new Base44 apps from scratch?',
    answer:
      'No. We unstick existing apps - publish, domains, data, production. We do not sell greenfield builds as a productized service.',
  },
  {
    question: 'How do I start?',
    answer:
      'Use the <a href="/start">diagnostic form</a>. It opens your email client with a structured case to na0ryank0@gmail.com - no third-party form backend.',
  },
]

const unstick = [
  {
    title: 'Deploy said success. Live did not move.',
    body: 'Build failed, blank screen after publish, or a stale live URL. We start with status, then logs.',
    href: '/base44-not-working',
    flip: false,
    viz: '/viz/fault-publish.svg',
    vizAlt: 'Diagram: build reports success while live stays unchanged',
  },
  {
    title: 'Works on Base44. Breaks on yours.',
    body: 'DNS, Cloudflare proxy, certificate still pending. Custom domain stuck in limbo.',
    href: '/custom-domains',
    flip: true,
    viz: '/viz/fault-domain.svg',
    vizAlt: 'Diagram: DNS to proxy to SSL still pending',
  },
  {
    title: 'Schema drifted after an AI edit.',
    body: 'Records missing, validation errors you cannot trace, entity fields that no longer match production.',
    href: null,
    flip: false,
    wide: true,
    viz: '/viz/fault-schema.svg',
    vizAlt: 'Diagram: entity schema version mismatch',
  },
  {
    title: 'Fine in preview. Dead in production.',
    body: 'Connectors, env, assets, or auth that only fail once the app is live.',
    href: null,
    flip: true,
    viz: '/viz/fault-preview.svg',
    vizAlt: 'Diagram: preview healthy, production breaks',
  },
]

const faultPhrases = [
  'publish success, live unchanged',
  'SSL pending',
  'schema mismatch',
  'blank after deploy',
  'preview fine, prod broken',
  'entity field drift',
  'DNS not propagating',
  'connector timeout',
]
---

<Layout
  title="Base44 Expert - Unstick stuck Base44 apps"
  description="Specialist studio for Base44 publish errors, custom domain SSL, schema mismatches, and preview-vs-production blockers. Start a diagnostic."
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Hero: molten mark drips, settles into living mark + wordmark -->
    <section class="hero-melt" aria-labelledby="hero-heading">
      <div class="melt-stage" aria-hidden="true">
        <div class="melt-glow-pulse"></div>
        <img class="lava-veins" src="/viz/lava-veins.svg" alt="" width="800" height="600" />
        <img class="melt-blob" src="/logo-melt.svg" alt="" width="300" height="400" />
        <div class="melt-liquid"></div>
        <div class="melt-drip"></div>
        <div class="melt-drip-b"></div>
        <div class="melt-drip-c"></div>
        <div class="melt-puddle"></div>
        <div class="melt-ember"></div>
        <p class="melt-wordmark">Base44 <span>Expert</span></p>
      </div>
      <div class="hero-content max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl text-ink max-w-3xl text-balance mb-5 leading-[1.05]">
          Stuck Base44 apps thaw under heat.
        </h1>
        <p class="text-lg sm:text-xl text-muted max-w-xl leading-relaxed mb-8">
          Publish lies. Domains stall. Schema drifts. We find the fault line and fix it.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/start" class="btn-primary magnetic">Start a diagnostic</a>
          <a href="/work" class="btn-secondary">See the process</a>
        </div>
      </div>
    </section>

    <!-- Fault-line phrases: static chips with heat shimmer (no marquee) -->
    <div class="error-phrases">
      <ul class="error-phrases__list" role="list">
        {faultPhrases.map((phrase) => (
          <li>{phrase}</li>
        ))}
      </ul>
    </div>

    <!-- Scroll-scrub sticky heat band with morphing liquid orb -->
    <section class="scrub-sticky" aria-labelledby="scrub-heading">
      <div class="scrub-sticky__pin">
        <div class="scrub-orb" aria-hidden="true"></div>
        <div class="scrub-liquid" aria-hidden="true"></div>
        <div class="scrub-copy">
          <h2 id="scrub-heading" class="font-display text-3xl sm:text-5xl text-ink text-balance mb-4 leading-[1.08]">
            Heat finds the fault line.
          </h2>
          <p class="text-muted leading-relaxed">
            Status, logs, DNS, schema. Isolate first. Fix second. Explain always.
          </p>
        </div>
      </div>
    </section>

    <!-- What we unstick: asymmetric zig-zag + fault diagrams -->
    <section class="section-padding border-t border-line relative overflow-hidden" aria-labelledby="unstick-heading">
      <div
        class="parallax-glow pointer-events-none absolute -right-24 top-10 w-72 h-72 rounded-full opacity-40"
        aria-hidden="true"
        style="background: radial-gradient(circle, rgba(255,106,0,0.22), transparent 70%); filter: blur(12px);"
      ></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
        <h2 id="unstick-heading" class="view-reveal text-3xl sm:text-4xl text-ink mb-12 max-w-2xl">
          What we unstick
        </h2>
        <div class="flex flex-col gap-6 md:gap-8">
          {unstick.map((row) => (
            row.href ? (
              <a href={row.href} class={`unstick-row${row.flip ? ' is-flip' : ''}${row.wide ? ' is-wide' : ''}`}>
                <div class="unstick-meta">
                  <h3 class="font-display text-2xl sm:text-3xl text-ink leading-tight">{row.title}</h3>
                  <p class="text-muted leading-relaxed max-w-prose mt-3">{row.body}</p>
                </div>
                <img class="unstick-viz" src={row.viz} alt={row.vizAlt} width="320" height="200" loading="lazy" />
              </a>
            ) : (
              <div class={`unstick-row${row.flip ? ' is-flip' : ''}${row.wide ? ' is-wide' : ''}`}>
                <div class="unstick-meta">
                  <h3 class="font-display text-2xl sm:text-3xl text-ink leading-tight">{row.title}</h3>
                  <p class="text-muted leading-relaxed max-w-prose mt-3">{row.body}</p>
                </div>
                <img class="unstick-viz" src={row.viz} alt={row.vizAlt} width="320" height="200" loading="lazy" />
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <ChangelogFeed limit={5} />

    <!-- Process strip -->
    <section class="section-padding border-t border-line" aria-labelledby="method-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="method-heading" class="view-reveal text-3xl sm:text-4xl text-ink mb-10">
          Diagnostic first. Then the fix.
        </h2>
        <div class="process-strip view-reveal-delay">
          {[
            { t: 'Intake', d: 'You describe the stuck moment, app URL, and last change.' },
            { t: 'Isolate', d: 'Status, logs, DNS, schema, connectors - find the real fault line.' },
            { t: 'Fix', d: 'Scoped change in place. No rebuild-everything by default.' },
            { t: 'Explain', d: 'What broke, why, and how to avoid the same trap next time.' },
          ].map((s) => (
            <div class="process-cell">
              <h3 class="font-display text-xl text-ink mb-2">{s.t}</h3>
              <p class="text-sm text-muted leading-relaxed">{s.d}</p>
            </div>
          ))}
        </div>
        <p class="mt-8">
          <a href="/work" class="link-draw text-sm">Full process</a>
        </p>
      </div>
    </section>

    <!-- Blog teaser -->
    <section class="section-padding border-t border-line bg-bg-2" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8">
          <h2 id="blog-heading" class="view-reveal text-3xl sm:text-4xl text-ink">Latest notes</h2>
          <a href="/blog" class="link-draw text-sm text-muted shrink-0">All posts</a>
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { href: '/blog/base44-not-working', title: 'Base44 not working: a calm triage order', d: 'Status first, then publish, domain, and schema.' },
            { href: '/blog/base44-publish-error', title: 'When publish says success but live is unchanged', d: 'Stale cache, failed build, wrong target.' },
            { href: '/blog/base44-custom-domain-ssl', title: 'Custom domain SSL still pending', d: 'DNS, proxy, and certificate timing.' },
            { href: '/blog/base44-changelog-what-changed', title: 'How to read the Base44 changelog', d: 'Official notes, status, and what it means for stuck apps.' },
          ].map((p) => (
            <li class="view-reveal">
              <a href={p.href} class="card-panel block h-full hover:border-accent/40 transition-colors group">
                <h3 class="font-display text-xl text-ink mb-2 group-hover:text-accent transition-colors">{p.title}</h3>
                <p class="text-sm text-muted">{p.d}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ teaser -->
    <section class="section-padding border-t border-line" aria-labelledby="faq-teaser-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="faq-teaser-heading" class="view-reveal text-3xl sm:text-4xl text-ink mb-8">Quick answers</h2>
        <FaqList items={faqTeaser} idPrefix="home-faq" />
        <p class="mt-6 text-sm">
          <a href="/faq" class="link-draw">Full FAQ</a>
        </p>
      </div>
    </section>

    <!-- FixTheBase aside -->
    <section class="section-padding border-t border-line" aria-labelledby="fixthebase-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <aside class="glow-aside flex flex-col md:flex-row md:items-center md:justify-between gap-6 view-reveal">
          <div>
            <h2 id="fixthebase-heading" class="text-3xl text-ink mb-2">FixTheBase</h2>
            <p class="text-muted max-w-xl text-sm leading-relaxed">
              A related Base44-oriented tool from the same builder. Studio rescue work stays on Base44 Expert;
              FixTheBase is a separate product surface.
            </p>
          </div>
          <a href="https://fixthebase.com" class="btn-secondary shrink-0" rel="noopener noreferrer" target="_blank">
            Visit FixTheBase
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </aside>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section-padding border-t border-line relative overflow-hidden" aria-labelledby="cta-heading">
      <div
        class="parallax-glow pointer-events-none absolute inset-0 opacity-60"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(255,106,0,0.2), transparent 60%);"
      ></div>
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="cta-heading" class="view-reveal font-display text-3xl sm:text-4xl mb-4 text-ink">Ready to unstick it?</h2>
        <p class="text-muted mb-8 leading-relaxed max-w-prose mx-auto">
          Open a structured diagnostic email. No Formspree. No invented ticket queue - just a clear case for us to reply to.
        </p>
        <a href="/start" class="btn-primary magnetic">Start a diagnostic</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  // IntersectionObserver fallback when CSS scroll-driven animations are unsupported.
  // No window scroll listeners; no React state.
  const supportsViewTimeline =
    typeof CSS !== 'undefined' &&
    typeof CSS.supports === 'function' &&
    CSS.supports('animation-timeline: view()')

  const reduce =
    typeof window !== 'undefined' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!supportsViewTimeline && !reduce) {
    const targets = document.querySelectorAll('.view-reveal, .view-reveal-delay')
    if (targets.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-inview', '')
              io.unobserve(entry.target)
            }
          }
        },
        { threshold: 0.2, rootMargin: '0px 0px -8% 0px' }
      )
      targets.forEach((el) => io.observe(el))
    } else {
      targets.forEach((el) => el.setAttribute('data-inview', ''))
    }
  }
</script>
