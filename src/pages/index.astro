---
import Layout from '../layouts/Layout.astro'
import ChangelogFeed from '../components/ChangelogFeed.astro'
import FaqList from '../components/FaqList.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Base44 Expert',
  url: 'https://base44expert.com',
  description:
    'Independent specialist studio that unsticks stuck Base44 apps: publish errors, custom domains, schema mismatches, and production blockers.',
  email: 'na0ryank0@gmail.com',
  areaServed: 'Worldwide',
  knowsAbout: [
    'Base44',
    'Base44 publish errors',
    'Base44 custom domains',
    'Base44 entity schemas',
    'Base44 production debugging',
  ],
  sameAs: ['https://fixthebase.com'],
}

const faqTeaser = [
  {
    question: 'Are you affiliated with Base44 or Wix?',
    answer:
      'No. Base44 Expert is an independent studio. For platform outages, check <a href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a> and the official docs.',
  },
  {
    question: 'Do you build new Base44 apps from scratch?',
    answer:
      'No. We unstick existing apps — publish, domains, data, production. We do not sell greenfield builds as a productized service.',
  },
  {
    question: 'How do I start?',
    answer:
      'Use the <a href="/start">diagnostic form</a>. It opens your email client with a structured case to na0ryank0@gmail.com — no third-party form backend.',
  },
]
---

<Layout
  title="Base44 Expert — Unstick stuck Base44 apps"
  description="Specialist studio for Base44 publish errors, custom domain SSL, schema mismatches, and preview-vs-production blockers. Start a diagnostic."
  jsonLd={jsonLd}
>
  <main id="main">
    <section class="section-padding border-b border-line" aria-labelledby="hero-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-4">Specialist studio · English</p>
        <h1 id="hero-heading" class="text-4xl sm:text-5xl lg:text-6xl text-ink max-w-3xl text-balance mb-6">
          Your Base44 app is stuck. We get it unstuck.
        </h1>
        <p class="text-lg sm:text-xl text-stone max-w-2xl leading-relaxed mb-8">
          Publish said success but the live URL did not change. Domain pending SSL.
          Schema mismatch. Preview fine, production broken. We read logs, DNS, and configs — then fix and explain.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/start" class="btn-primary">Start a diagnostic</a>
          <a href="/work" class="btn-secondary">See the process</a>
        </div>
      </div>
    </section>

    <ChangelogFeed limit={5} />

    <section class="section-padding border-t border-line" aria-labelledby="unstick-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">What we unstick</p>
        <h2 id="unstick-heading" class="text-3xl sm:text-4xl text-ink mb-10 max-w-2xl">
          Specific stuck moments — not a digital landscape pitch
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <a href="/base44-not-working" class="card-panel hover:border-ink transition-colors block group">
            <h3 class="font-display text-2xl text-ink mb-2 group-hover:text-accent">Publish &amp; deploy</h3>
            <p class="text-stone text-sm leading-relaxed">
              Build failed, publish reported success with no live change, blank screen after publish.
              Start with status, then logs.
            </p>
          </a>
          <a href="/custom-domains" class="card-panel hover:border-ink transition-colors block group">
            <h3 class="font-display text-2xl text-ink mb-2 group-hover:text-accent">Custom domains &amp; SSL</h3>
            <p class="text-stone text-sm leading-relaxed">
              Works on the Base44 URL, breaks on yours. DNS, Cloudflare proxy, certificate pending.
            </p>
          </a>
          <div class="card-panel">
            <h3 class="font-display text-2xl text-ink mb-2">Data &amp; schema</h3>
            <p class="text-stone text-sm leading-relaxed">
              Records missing, validation errors you cannot trace, entity fields that drifted after an AI edit.
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-2xl text-ink mb-2">Preview vs production</h3>
            <p class="text-stone text-sm leading-relaxed">
              Connectors, env, assets, or auth that only fail once the app is live.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding border-t border-line bg-white" aria-labelledby="method-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Method</p>
        <h2 id="method-heading" class="text-3xl sm:text-4xl text-ink mb-10">Diagnostic first. Then the fix.</h2>
        <ol class="grid grid-cols-1 md:grid-cols-4 gap-6 list-none">
          {[
            { n: '01', t: 'Intake', d: 'You describe the stuck moment, app URL, and last change.' },
            { n: '02', t: 'Isolate', d: 'Status page, logs, DNS, schema, connectors — find the real fault line.' },
            { n: '03', t: 'Fix', d: 'Scoped change in place. No rebuild-everything by default.' },
            { n: '04', t: 'Explain', d: 'What broke, why, and how to avoid the same trap next time.' },
          ].map((s) => (
            <li class="border-t border-line pt-4">
              <p class="font-mono text-xs text-accent mb-2">{s.n}</p>
              <h3 class="font-display text-xl text-ink mb-2">{s.t}</h3>
              <p class="text-sm text-stone leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
        <p class="mt-8">
          <a href="/work" class="text-sm text-ink underline underline-offset-2">Full process →</a>
        </p>
      </div>
    </section>

    <section class="section-padding border-t border-line" aria-labelledby="paths-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Keyword paths</p>
        <h2 id="paths-heading" class="text-3xl sm:text-4xl text-ink mb-8">Go straight to the problem page</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 font-mono text-sm">
          <li><a class="block card-panel hover:border-ink" href="/base44-not-working">base44 not working</a></li>
          <li><a class="block card-panel hover:border-ink" href="/blog/base44-publish-error">base44 publish error</a></li>
          <li><a class="block card-panel hover:border-ink" href="/custom-domains">base44 custom domain</a></li>
          <li><a class="block card-panel hover:border-ink" href="/base44-expert">base44 expert</a></li>
          <li><a class="block card-panel hover:border-ink" href="/updates">base44 changelog</a></li>
          <li><a class="block card-panel hover:border-ink" href="/faq">FAQ</a></li>
        </ul>
      </div>
    </section>

    <section class="section-padding border-t border-line" aria-labelledby="blog-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-8">
          <div>
            <p class="label-eyebrow mb-2">Blog</p>
            <h2 id="blog-heading" class="text-3xl sm:text-4xl text-ink">Latest notes</h2>
          </div>
          <a href="/blog" class="text-sm text-stone underline underline-offset-2 shrink-0">All posts</a>
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {[
            { href: '/blog/base44-not-working', title: 'Base44 not working: a calm triage order', d: 'Status first, then publish, domain, and schema.' },
            { href: '/blog/base44-publish-error', title: 'When publish says success but live is unchanged', d: 'Stale cache, failed build, wrong target.' },
            { href: '/blog/base44-custom-domain-ssl', title: 'Custom domain SSL still pending', d: 'DNS, proxy, and certificate timing.' },
            { href: '/blog/base44-changelog-what-changed', title: 'How to read the Base44 changelog', d: 'Product RSS, status, and what it means for stuck apps.' },
          ].map((p) => (
            <li>
              <a href={p.href} class="card-panel block h-full hover:border-ink">
                <h3 class="font-display text-xl text-ink mb-2">{p.title}</h3>
                <p class="text-sm text-stone">{p.d}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-padding border-t border-line bg-white" aria-labelledby="faq-teaser-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">FAQ</p>
        <h2 id="faq-teaser-heading" class="text-3xl sm:text-4xl text-ink mb-8">Quick answers</h2>
        <FaqList items={faqTeaser} idPrefix="home-faq" />
        <p class="mt-6 text-sm"><a href="/faq" class="underline underline-offset-2 text-ink">Full FAQ →</a></p>
      </div>
    </section>

    <section class="section-padding border-t border-line" aria-labelledby="fixthebase-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <p class="label-eyebrow mb-2">Also by us</p>
          <h2 id="fixthebase-heading" class="text-3xl text-ink mb-2">FixTheBase</h2>
          <p class="text-stone max-w-xl text-sm leading-relaxed">
            A related Base44-oriented tool from the same builder. Studio rescue work stays on Base44 Expert;
            FixTheBase is a separate product surface.
          </p>
        </div>
        <a href="https://fixthebase.com" class="btn-secondary" rel="noopener noreferrer" target="_blank">
          Visit FixTheBase
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
    </section>

    <section class="section-padding border-t border-line bg-ink text-paper" aria-labelledby="cta-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 id="cta-heading" class="font-display text-3xl sm:text-4xl mb-4 text-paper">Ready to unstick it?</h2>
        <p class="text-paper/70 mb-8 leading-relaxed">
          Open a structured diagnostic email. No Formspree. No invented ticket queue — just a clear case for us to reply to.
        </p>
        <a href="/start" class="btn-primary">Start a diagnostic</a>
      </div>
    </section>
  </main>
</Layout>
