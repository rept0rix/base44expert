---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Process', item: 'https://base44expert.com/work' },
  ],
}
---

<Layout
  title="Process — Base44 Expert"
  description="How Base44 Expert unsticks apps: intake, isolate (status/logs/DNS/schema), scoped fix, written explanation. No discovery theatre."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding border-b border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Process</p>
        <h1 class="text-4xl sm:text-5xl text-ink mb-6 max-w-3xl text-balance">How we get your app unstuck</h1>
        <p class="text-lg text-stone max-w-2xl leading-relaxed">
          No discovery calls as a product. You describe what’s broken, we investigate, and if we can fix it we do —
          with a written explanation of the fault line.
        </p>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="steps-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="steps-heading" class="sr-only">Steps</h2>
        <ol class="space-y-14">
          {[
            {
              n: '01',
              t: 'Intake',
              d: 'You send a structured case via /start or a short email: problem type, app URL, error text, last change. We reply with next diagnostic steps — not a sales deck.',
            },
            {
              n: '02',
              t: 'Isolate',
              d: 'We check platform status first, then publish logs, DNS/SSL, entity schemas, connectors, and preview-vs-prod differences until one cause remains.',
            },
            {
              n: '03',
              t: 'Fix in place',
              d: 'Scoped change. We prefer unstick over rebuild. If migration or a full rewrite is the honest answer, we say so before doing it.',
            },
            {
              n: '04',
              t: 'Explain & handoff',
              d: 'You get what broke, why it broke, and how to avoid the same trap. Then the app is yours again.',
            },
          ].map((s) => (
            <li class="flex flex-col md:flex-row gap-6 md:gap-10">
              <div class="font-mono text-accent text-sm shrink-0 w-12">{s.n}</div>
              <div>
                <h3 class="font-display text-2xl text-ink mb-3">{s.t}</h3>
                <p class="text-stone leading-relaxed max-w-2xl">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section-padding border-t border-line bg-bg-2" aria-labelledby="scope-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="scope-heading" class="text-3xl text-ink mb-6">Scope honesty</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">In scope</h3>
            <ul class="text-sm text-stone space-y-2">
              <li>Publish / deploy failures and stale live output</li>
              <li>Custom domain DNS and SSL pending</li>
              <li>Entity schema mismatches</li>
              <li>Production-only connector or asset failures</li>
            </ul>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Out of scope</h3>
            <ul class="text-sm text-stone space-y-2">
              <li>Greenfield Base44 app builds as a package</li>
              <li>Official Base44 support substitution</li>
              <li>Invented SLAs, fake queues, or fake client logos</li>
            </ul>
          </div>
        </div>
        <p class="mt-10">
          <a href="/start" class="btn-primary">Start a diagnostic</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
