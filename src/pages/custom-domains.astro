---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Custom domains', item: 'https://base44expert.com/custom-domains' },
  ],
}
---

<Layout
  title="Base44 custom domains & SSL — Base44 Expert"
  description="When your Base44 app works on the platform URL but custom domain SSL stays pending: DNS, Cloudflare proxy, and certificate timing. Studio help + official docs."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding border-b border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl text-ink mb-6 max-w-3xl text-balance">Custom domain works on Base44 URL — not on yours</h1>
        <p class="text-lg text-stone max-w-2xl leading-relaxed">
          We complement Base44’s official guide; we do not rewrite it.
          Start here:
          <a class="underline underline-offset-2 text-ink" href="https://docs.base44.com/Setting-up-your-app/Setting-up-your-custom-domain" rel="noopener noreferrer" target="_blank">Setting up your custom domain</a>.
        </p>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="checks-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="checks-heading" class="text-3xl text-ink mb-8">What we usually check</h2>
        <div class="grid md:grid-cols-2 gap-5">
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">DNS records</h3>
            <p class="text-sm text-stone leading-relaxed">
              Correct host targets, propagation delay, and typos between apex and www.
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Cloudflare / proxy</h3>
            <p class="text-sm text-stone leading-relaxed">
              Orange-cloud proxy can block certificate issuance. DNS-only is often required until SSL is live.
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">SSL pending</h3>
            <p class="text-sm text-stone leading-relaxed">
              Certificate issuance needs correct DNS first. Pending for hours usually means records or proxy, not “try publishing again.”
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Redirect chains</h3>
            <p class="text-sm text-stone leading-relaxed">
              www ↔ apex and http → https loops that look like “the app is down.”
            </p>
          </div>
        </div>
        <p class="mt-8 text-sm text-stone">
          Also see <a class="underline text-ink" href="/blog/base44-custom-domain-ssl">our SSL pending note</a>
          and <a class="underline text-ink" href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status</a> if Hosting is degraded.
        </p>
        <p class="mt-8">
          <a href="/start" class="btn-primary">Start a domain diagnostic</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
