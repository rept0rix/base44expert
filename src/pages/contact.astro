---
import Layout from '../layouts/Layout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
---

<Layout 
  title="Contact - Base44 Expert"
  description="Tell us what's not working with your Base44 app and we'll help you fix it. Fast diagnostics and clear solutions."
>
  <Nav />
  
  <main>
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-slate-50 to-white py-16 sm:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mb-6 text-balance">
          Get help with Base44
        </h1>
        <p class="text-xl sm:text-2xl text-slate-600 mb-8 leading-relaxed">
          Tell us what's not working and we'll take a look. The more details you provide, the faster we can help.
        </p>
      </div>
    </section>

    <!-- Form Section -->
    <section class="section-padding bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Form -->
          <div class="lg:col-span-2">
            <form 
              action="https://formspree.io/f/YOUR_FORM_ID"
              method="POST"
              class="space-y-6"
            >
              <div>
                <label for="name" class="block text-sm font-semibold text-slate-900 mb-2">
                  Your name
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-transparent transition-colors"
                  placeholder="John Smith"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-semibold text-slate-900 mb-2">
                  Email address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-transparent transition-colors"
                  placeholder="john@company.com"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-semibold text-slate-900 mb-2">
                  What's not working?
                </label>
                <p class="text-sm text-slate-600 mb-3">
                  Include error messages, your app URL, and what you were trying to do when the problem happened.
                </p>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="10"
                  class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-700 focus:border-transparent transition-colors resize-y"
                  placeholder="I'm trying to publish my Base44 app but getting an error: &#10;&#10;[paste error message here]&#10;&#10;My app URL: https://..."
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full sm:w-auto px-8 py-4 text-base font-semibold rounded-lg text-white bg-teal-700 hover:bg-teal-800 transition-colors shadow-lg shadow-teal-700/20"
              >
                Send message
              </button>
            </form>

            <div class="mt-8 p-4 bg-amber-50 border border-amber-200 rounded-lg">
              <div class="flex gap-3">
                <svg class="w-5 h-5 text-amber-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <p class="text-sm text-amber-800">
                  <strong>Setup required:</strong> Replace <code class="bg-amber-100 px-2 py-0.5 rounded font-mono text-xs">YOUR_FORM_ID</code> in the form with your actual Formspree form ID, or use another service like Getform.
                </p>
              </div>
            </div>
          </div>

          <!-- Sidebar Tips -->
          <div class="lg:col-span-1">
            <div class="sticky top-24">
              <h2 class="text-xl font-bold text-slate-900 mb-4">
                What to include
              </h2>
              <div class="space-y-4 text-sm text-slate-600">
                <p>
                  The more specific you are, the faster we can diagnose the problem:
                </p>
                <ul class="space-y-3">
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>The exact error message</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>Your Base44 app URL or project ID</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>What you were doing when it broke</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>What type of issue: publish, data, connectors, domain</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-teal-700 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span>For domain issues: your domain name and DNS provider</span>
                  </li>
                </ul>
                <div class="pt-4 border-t border-slate-200">
                  <p class="font-medium text-slate-900">
                    Response time
                  </p>
                  <p class="mt-1">
                    We respond within 24 hours, usually faster.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
