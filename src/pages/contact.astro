---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://base44expert.com/contact' },
  ],
}
---

<Layout
  title="Contact — Base44 Expert"
  description="Email Base44 Expert about a stuck app. Mailto intake only — no Formspree. Prefer the structured diagnostic at /start."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Contact</p>
        <h1 class="text-4xl sm:text-5xl text-ink mb-4 text-balance">Email us what’s stuck</h1>
        <p class="text-lg text-stone max-w-2xl leading-relaxed mb-10">
          This opens your mail app to na0ryank0@gmail.com with your note filled in.
          There is no form backend and no ticket portal. For a structured case, use
          <a href="/start" class="underline underline-offset-2 text-ink">Start a diagnostic</a>.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <div class="lg:col-span-2">
            <form id="contact-form" class="space-y-6">
              <div>
                <label for="name" class="block text-sm font-medium text-ink mb-2">Your name</label>
                <input type="text" id="name" name="name" required autocomplete="name"
                  class="w-full px-4 py-3 border border-line rounded bg-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent" />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-ink mb-2">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email"
                  class="w-full px-4 py-3 border border-line rounded bg-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent" />
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-ink mb-2">What’s not working?</label>
                <p class="text-sm text-stone mb-2">Error text, app URL, and what you were doing. No passwords or API keys.</p>
                <textarea id="message" name="message" required rows="10"
                  class="w-full px-4 py-3 border border-line rounded bg-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent resize-y"
                  placeholder="Publish said success but live is unchanged…"></textarea>
              </div>
              <button type="submit" class="btn-primary">Open email to send</button>
            </form>
            <p class="mt-4 text-sm text-stone">
              Opens mail to
              <a href="mailto:na0ryank0@gmail.com?subject=Base44%20help%20request" class="underline underline-offset-2 text-ink">na0ryank0@gmail.com</a>.
            </p>
          </div>
          <aside class="lg:col-span-1" aria-labelledby="include-heading">
            <h2 id="include-heading" class="font-display text-xl text-ink mb-4">What helps</h2>
            <ul class="space-y-3 text-sm text-stone">
              <li>Exact error message</li>
              <li>App URL or project id</li>
              <li>Last change (AI edit, publish, DNS)</li>
              <li>Type: publish, domain, data, production</li>
              <li>For domains: registrar / Cloudflare proxy on or off</li>
            </ul>
            <p class="mt-6 text-sm text-stone border-t border-line pt-4">
              Rule out platform outages at
              <a href="https://status.base44.com" class="underline underline-offset-2 text-ink" rel="noopener noreferrer" target="_blank">status.base44.com</a>
              and skim
              <a href="https://docs.base44.com/Community-and-support/Troubleshooting" class="underline underline-offset-2 text-ink" rel="noopener noreferrer" target="_blank">official troubleshooting</a>.
            </p>
          </aside>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    const name = (document.getElementById('name') as HTMLInputElement).value.trim()
    const email = (document.getElementById('email') as HTMLInputElement).value.trim()
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim()
    const subject = encodeURIComponent('Base44 help request')
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\n${message}`)
    window.location.href = `mailto:na0ryank0@gmail.com?subject=${subject}&body=${body}`
  })
</script>
