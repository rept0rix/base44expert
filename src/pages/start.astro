---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Start', item: 'https://base44expert.com/start' },
  ],
}

const tipChips = [
  { v: 'publish', l: 'Publish / deploy' },
  { v: 'domain', l: 'Domain & SSL' },
  { v: 'data', l: 'Data & schema' },
  { v: 'preview', l: 'Preview vs live' },
  { v: 'auth', l: 'Auth & users' },
  { v: 'ai-edit', l: 'AI edit broke it' },
  { v: 'payments', l: 'Payments' },
  { v: 'other', l: 'Something else' },
]
---

<Layout
  title="Start a diagnostic - Base44 Expert"
  description="Base44 app stuck? Publish error, custom domain SSL, schema mismatch, or preview vs live — open a free diagnostic. We reply with the next step."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding relative overflow-hidden page-heat">
      <div class="page-heat__glow" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(255,106,0,0.12), transparent 55%);"
      ></div>
      <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <img class="start-melt-mark" src="/logo-melt.svg" alt="" width="72" height="96" />
        <img class="page-heat__viz mt-4 mb-6" src="/viz/fault-publish.svg" alt="" width="320" height="200" />
        <h1 class="text-4xl sm:text-5xl text-ink mb-4 text-balance leading-[1.05]">
          Base44 app stuck? Start a diagnostic.
        </h1>
        <p class="text-muted leading-relaxed mb-6">
          Publish errors, custom domain / SSL limbo, schema drift, preview vs live mismatch — or anything else that froze your app.
          We unstick stuck Base44 apps and reply with a concrete next step.
          Tell us what broke; we open a case thread by email.
        </p>
        <ul class="mb-10 space-y-2 text-sm text-muted border border-line rounded-xl bg-bg-2 pad-inset-lg">
          <li>Paste the exact error text and the app URL (preview + live if they differ).</li>
          <li>Say what you changed last (AI edit, domain, publish, schema).</li>
          <li>Screenshots help — attach them in the email after it opens.</li>
          <li>No passwords or API keys in the message.</li>
        </ul>

        <form id="diagnostic-form" class="space-y-8" novalidate>
          <div>
            <label for="stuckShort" class="block font-display text-xl text-ink mb-2">1. What's stuck?</label>
            <p class="text-sm text-muted mb-2">One short line — optional tags below if they help.</p>
            <input
              type="text"
              id="stuckShort"
              name="stuckShort"
              autocomplete="off"
              placeholder="e.g. Publish says success but live is still old"
              class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm placeholder:text-muted/60 focus:outline-none focus:ring-2 focus:ring-accent"
            />
            <fieldset class="mt-3 space-y-2">
              <legend class="sr-only">Optional problem tags</legend>
              <p class="text-xs text-muted mb-2">Optional tags (not required):</p>
              <div class="flex flex-wrap gap-2">
                {tipChips.map((o) => (
                  <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-line bg-bg-2 text-sm text-ink cursor-pointer has-[:checked]:border-accent has-[:checked]:text-accent transition-colors">
                    <input type="checkbox" name="typeChip" value={o.v} class="sr-only" />
                    <span>{o.l}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>

          <fieldset class="space-y-3">
            <legend class="font-display text-xl text-ink mb-2">2. How urgent?</legend>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {[
                { v: 'today', l: 'Need it today' },
                { v: 'this-week', l: 'This week' },
                { v: 'exploring', l: 'Exploring options' },
              ].map((o) => (
                <label class="card-panel flex items-center gap-3 cursor-pointer has-[:checked]:border-accent transition-colors">
                  <input type="radio" name="urgency" value={o.v} required class="accent-[var(--color-accent)]" />
                  <span class="text-sm text-ink">{o.l}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="appUrl" class="block font-display text-xl text-ink mb-2">3. App URL</label>
            <p class="text-sm text-muted mb-2">Base44 URL or custom domain that is broken or stale.</p>
            <input
              type="url"
              id="appUrl"
              name="appUrl"
              required
              autocomplete="url"
              placeholder="https://your-app.base44.app"
              class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm placeholder:text-muted/60 focus:outline-none focus:ring-2 focus:ring-accent"
            />
          </div>

          <div>
            <label for="errorText" class="block font-display text-xl text-ink mb-2">4. What went wrong?</label>
            <p class="text-sm text-muted mb-2">Exact error text if any, last change, and what you expected to see live.</p>
            <textarea
              id="errorText"
              name="errorText"
              required
              rows="7"
              class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm placeholder:text-muted/60 focus:outline-none focus:ring-2 focus:ring-accent resize-y"
              placeholder="Publish said success but live still shows the old version..."
            ></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block font-display text-xl text-ink mb-2">5. Your name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent"
              />
            </div>
            <div>
              <label for="email" class="block font-display text-xl text-ink mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent"
              />
            </div>
          </div>

          <p id="case-preview" class="text-xs text-muted font-mono hidden" aria-live="polite"></p>

          <button type="submit" class="btn-primary magnetic w-full sm:w-auto">
            Open email, then hit Send
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  function caseId() {
    const t = Date.now().toString(36).toUpperCase()
    const r = Math.random().toString(36).slice(2, 6).toUpperCase()
    return `B44-${t}-${r}`
  }

  const form = document.getElementById('diagnostic-form') as HTMLFormElement | null
  const preview = document.getElementById('case-preview')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }
    const fd = new FormData(form)
    const stuckShort = String(fd.get('stuckShort') || '').trim()
    const chips = fd.getAll('typeChip').map((v) => String(v))
    const urgency = String(fd.get('urgency') || 'exploring')
    const appUrl = String(fd.get('appUrl') || '').trim()
    const errorText = String(fd.get('errorText') || '').trim()
    const name = String(fd.get('name') || '').trim()
    const email = String(fd.get('email') || '').trim()
    const id = caseId()

    // Type label: prefer free short title, else first chip, else other
    const typeLabel = stuckShort
      ? stuckShort.slice(0, 60)
      : chips.length > 0
        ? chips.join('+')
        : 'other'

    if (preview) {
      preview.textContent = `Case id: ${id}`
      preview.classList.remove('hidden')
    }

    const subject = encodeURIComponent(`Base44 case ${id} - ${typeLabel} - ${urgency}`)
    const bodyLines = [
      `Case id: ${id}`,
      `What's stuck: ${stuckShort || '(not provided)'}`,
      chips.length ? `Tags: ${chips.join(', ')}` : null,
      `Urgency: ${urgency}`,
      `Name: ${name}`,
      `Email: ${email}`,
      `App URL: ${appUrl}`,
      '',
      'What went wrong:',
      errorText,
      '',
      '(Generated by base44expert.com/start - client-side case id, no form backend.)',
    ].filter((line) => line !== null) as string[]

    const body = encodeURIComponent(bodyLines.join('\n'))
    window.location.href = `mailto:na0ryank0@gmail.com?subject=${subject}&body=${body}`
  })
</script>
