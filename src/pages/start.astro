---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Start', item: 'https://base44expert.com/start' },
  ],
}
---

<Layout
  title="Start a diagnostic - Base44 Expert"
  description="Stuck Base44 app? Open a structured diagnostic case by email. Publish, domain SSL, schema, or preview-vs-live - we reply with a next step."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(255,106,0,0.12), transparent 55%);"
      ></div>
      <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <img class="start-melt-mark" src="/logo-melt.svg" alt="" width="72" height="96" />
        <h1 class="text-4xl sm:text-5xl text-ink mb-4 text-balance leading-[1.05]">
          Your Base44 app is stuck. Open a diagnostic case.
        </h1>
        <p class="text-muted leading-relaxed mb-6">
          Fill this once. Your mail app opens with a case id, the problem type, and the details already written.
          Hit Send. We reply on that thread with what we need next - not a ticket portal, not a chatbot.
        </p>
        <ul class="mb-10 space-y-2 text-sm text-muted border border-line rounded-xl bg-bg-2 pad-inset-lg">
          <li>We unstick existing apps: publish, custom domain / SSL, schema, preview vs production.</li>
          <li>We do not greenfield-build apps. Platform outages → <a class="underline underline-offset-2 text-accent hover:text-accent-2" href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a>.</li>
          <li>No passwords or API keys in the message.</li>
        </ul>

        <form id="diagnostic-form" class="space-y-8" novalidate>
          <fieldset class="space-y-3">
            <legend class="font-display text-xl text-ink mb-2">1. What kind of stuck?</legend>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {[
                { v: 'publish', l: 'Publish / deploy' },
                { v: 'domain', l: 'Custom domain / SSL' },
                { v: 'data', l: 'Data / schema' },
                { v: 'production', l: 'Preview vs production' },
              ].map((o) => (
                <label class="card-panel flex items-center gap-3 cursor-pointer has-[:checked]:border-accent transition-colors">
                  <input type="radio" name="type" value={o.v} required class="accent-[var(--color-accent)]" />
                  <span class="text-sm text-ink">{o.l}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="space-y-3">
            <legend class="font-display text-xl text-ink mb-2">2. How urgent?</legend>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {[
                { v: 'today', l: 'Need it today' },
                { v: 'this-week', l: 'This week' },
                { v: 'exploring', l: 'Exploring options' },
              ].map((o) => (
                <label class="card-panel flex items-center gap-3 cursor-pointer has-[:checked]:border-accent transition-colors">
                  <input type="radio" name="urgency" value={o.v} required class="accent-[var(--color-accent)]" />
                  <span class="text-sm text-ink">{o.l}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="appUrl" class="block font-display text-xl text-ink mb-2">3. App URL</label>
            <p class="text-sm text-muted mb-2">Base44 URL or custom domain that is broken or stale.</p>
            <input
              type="url"
              id="appUrl"
              name="appUrl"
              required
              autocomplete="url"
              placeholder="https://your-app.base44.app"
              class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm placeholder:text-muted/60 focus:outline-none focus:ring-2 focus:ring-accent"
            />
          </div>

          <div>
            <label for="errorText" class="block font-display text-xl text-ink mb-2">4. What went wrong?</label>
            <p class="text-sm text-muted mb-2">Exact error text if any, last change, and what you expected to see live.</p>
            <textarea
              id="errorText"
              name="errorText"
              required
              rows="7"
              class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm placeholder:text-muted/60 focus:outline-none focus:ring-2 focus:ring-accent resize-y"
              placeholder="Publish said success but live still shows the old version..."
            ></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block font-display text-xl text-ink mb-2">5. Your name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent"
              />
            </div>
            <div>
              <label for="email" class="block font-display text-xl text-ink mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-3 border border-line rounded-xl bg-bg-2 text-ink font-mono text-sm focus:outline-none focus:ring-2 focus:ring-accent"
              />
            </div>
          </div>

          <p id="case-preview" class="text-xs text-muted font-mono hidden" aria-live="polite"></p>

          <button type="submit" class="btn-primary w-full sm:w-auto">
            Open email, then hit Send
          </button>
          <p class="text-sm text-muted">
            Prefer a short note? Use <a href="/contact" class="underline underline-offset-2 text-accent hover:text-accent-2">contact</a>.
            Platform down? Check <a href="https://status.base44.com" class="underline underline-offset-2 text-accent hover:text-accent-2" rel="noopener noreferrer" target="_blank">status.base44.com</a> first.
          </p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  function caseId() {
    const t = Date.now().toString(36).toUpperCase()
    const r = Math.random().toString(36).slice(2, 6).toUpperCase()
    return `B44-${t}-${r}`
  }

  const form = document.getElementById('diagnostic-form') as HTMLFormElement | null
  const preview = document.getElementById('case-preview')

  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    if (!form.checkValidity()) {
      form.reportValidity()
      return
    }
    const fd = new FormData(form)
    const type = String(fd.get('type') || 'other')
    const urgency = String(fd.get('urgency') || 'exploring')
    const appUrl = String(fd.get('appUrl') || '').trim()
    const errorText = String(fd.get('errorText') || '').trim()
    const name = String(fd.get('name') || '').trim()
    const email = String(fd.get('email') || '').trim()
    const id = caseId()

    if (preview) {
      preview.textContent = `Case id: ${id}`
      preview.classList.remove('hidden')
    }

    const subject = encodeURIComponent(`Base44 case ${id} - ${type} - ${urgency}`)
    const body = encodeURIComponent(
      [
        `Case id: ${id}`,
        `Type: ${type}`,
        `Urgency: ${urgency}`,
        `Name: ${name}`,
        `Email: ${email}`,
        `App URL: ${appUrl}`,
        '',
        'What went wrong:',
        errorText,
        '',
        '(Generated by base44expert.com/start - client-side case id, no form backend.)',
      ].join('\n')
    )
    window.location.href = `mailto:na0ryank0@gmail.com?subject=${subject}&body=${body}`
  })
</script>
