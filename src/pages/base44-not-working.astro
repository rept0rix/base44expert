---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Base44 not working', item: 'https://base44expert.com/base44-not-working' },
  ],
}
---

<Layout
  title="Base44 not working — triage guide | Base44 Expert"
  description="Calm triage when Base44 is not working: check status, then publish, blank screen, domain, and schema. Independent studio diagnostic."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding page-heat border-b border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl text-ink mb-6 max-w-3xl text-balance">Base44 not working: a calm triage order</h1>
        <img class="page-heat__viz my-6" src="/viz/fault-preview.svg" alt="" width="320" height="200" />
        <p class="text-lg text-stone max-w-2xl leading-relaxed">
          “Not working” usually means one of a few stuck moments. Start with platform status, then narrow.
          Official reference:
          <a class="underline underline-offset-2 text-ink" href="https://docs.base44.com/Community-and-support/Troubleshooting" rel="noopener noreferrer" target="_blank">docs troubleshooting</a>.
        </p>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="order-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="order-heading" class="text-3xl text-ink mb-8">Check in this order</h2>
        <ol class="space-y-8">
          <li class="card-panel">
            <h3 class="font-display text-xl mb-2">1. Platform status</h3>
            <p class="text-sm text-stone leading-relaxed">
              Open <a class="underline text-ink" href="https://status.base44.com" rel="noopener noreferrer" target="_blank">status.base44.com</a>.
              If Builder, Hosting, or Login is degraded, wait on the incident before rewriting your app.
            </p>
          </li>
          <li class="card-panel">
            <h3 class="font-display text-xl mb-2">2. Publish / blank screen</h3>
            <p class="text-sm text-stone leading-relaxed">
              Did publish fail, or say success while live stayed old? Blank after an AI edit?
              Capture the exact message and when it started. See also
              <a class="underline text-ink" href="/blog/base44-publish-error">publish error notes</a>.
            </p>
          </li>
          <li class="card-panel">
            <h3 class="font-display text-xl mb-2">3. Custom domain</h3>
            <p class="text-sm text-stone leading-relaxed">
              App works on the Base44 URL but not yours? Jump to
              <a class="underline text-ink" href="/custom-domains">custom domains</a>.
            </p>
          </li>
          <li class="card-panel">
            <h3 class="font-display text-xl mb-2">4. Data / schema</h3>
            <p class="text-sm text-stone leading-relaxed">
              UI loads but records vanish or validation fails — field drift after edits is a common fault line.
            </p>
          </li>
        </ol>
        <p class="mt-10">
          <a href="/start" class="btn-primary magnetic">Start a diagnostic</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
