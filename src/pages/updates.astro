---
import Layout from '../layouts/Layout.astro'
import { getChangelogItems } from '../lib/changelog'

const { items, fromRss, productPage, statusPage } = await getChangelogItems(22)
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Updates', item: 'https://base44expert.com/updates' },
  ],
}

function kindLabel(kind: string) {
  return kind === 'developer' ? 'Developer' : 'Product'
}
---

<Layout
  title="Base44 updates — Base44 Expert"
  description="What’s new in Base44 for builders — product and developer notes from the official changelog."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding page-heat">
      <div class="page-heat__glow" aria-hidden="true"></div>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end gap-6 mb-4">
          <h1 class="text-4xl sm:text-5xl text-ink">What’s new in Base44</h1>
          <img class="page-heat__viz shrink-0" src="/blog/hero-changelog.svg" alt="" width="240" height="135" />
        </div>
        <p class="text-stone leading-relaxed mb-8">
          Fresh product and developer notes from Base44 — useful when you are shipping,
          debugging publish, or checking whether a platform change explains a stuck app.
        </p>
        <p class="text-sm text-stone mb-8 flex flex-wrap gap-4">
          <a class="underline underline-offset-2 text-ink" href={productPage} rel="noopener noreferrer" target="_blank">Official changelog</a>
          <a class="underline underline-offset-2 text-ink" href={statusPage} rel="noopener noreferrer" target="_blank">Platform status</a>
          <a class="underline underline-offset-2 text-ink" href="https://docs.base44.com/Community-and-support/Troubleshooting" rel="noopener noreferrer" target="_blank">Troubleshooting docs</a>
        </p>

        {!fromRss && (
          <div class="mb-6 border border-line rounded-lg bg-bg-2 px-4 py-4 text-sm text-stone leading-relaxed">
            <p class="font-medium text-ink mb-1">Feed temporarily unavailable</p>
            <p>
              Browse the
              <a class="underline underline-offset-2 text-ink" href={productPage} rel="noopener noreferrer" target="_blank">official Base44 changelog</a>
              for the latest notes.
            </p>
          </div>
        )}

        <ul class="divide-y divide-line border border-line rounded-lg bg-bg-2 overflow-hidden pad-inset" role="list">
          {items.map((item) => (
            <li class="px-3 py-4">
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-accent-2">
                  {kindLabel(item.kind)}
                </span>
                {item.category && (
                  <span class="inline-flex items-center rounded-full border border-line px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-muted">
                    {item.category}
                  </span>
                )}
                {(item.dateLabel || item.date) && (
                  <time class="text-xs text-muted font-mono" datetime={item.date || undefined}>
                    {item.dateLabel || item.date}
                  </time>
                )}
              </div>
              <a href={item.link} class="text-ink font-medium hover:text-accent text-lg leading-snug" rel="noopener noreferrer" target="_blank">
                {item.title}
              </a>
              {item.summary && (
                <p class="text-sm text-stone mt-2 leading-relaxed">{item.summary}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
