---
import Layout from '../../layouts/Layout.astro'

const posts = [
  {
    href: '/blog/base44-not-working',
    title: 'Base44 not working: a calm triage order',
    description: 'Status first, then publish, blank screen, domain, and schema.',
    date: '2026-09-01',
  },
  {
    href: '/blog/base44-publish-error',
    title: 'When Base44 publish says success but live is unchanged',
    description: 'Separate build failure, stale output, and wrong target.',
    date: '2026-09-02',
  },
  {
    href: '/blog/base44-custom-domain-ssl',
    title: 'Base44 custom domain SSL still pending',
    description: 'DNS, Cloudflare proxy, and certificate timing.',
    date: '2026-09-03',
  },
  {
    href: '/blog/base44-changelog-what-changed',
    title: 'How to read the Base44 changelog when your app feels stuck',
    description: 'Official product RSS, status, and what not to invent.',
    date: '2026-09-04',
  },
]

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://base44expert.com/blog' },
  ],
}
---

<Layout
  title="Blog — Base44 Expert"
  description="Notes on Base44 publish errors, custom domain SSL, triage order, and reading the official changelog."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Blog</p>
        <h1 class="text-4xl sm:text-5xl text-ink mb-8">Notes from the studio</h1>
        <ul class="space-y-4" role="list">
          {posts.map((p) => (
            <li>
              <a href={p.href} class="card-panel block hover:border-ink">
                <time class="font-mono text-xs text-stone" datetime={p.date}>{p.date}</time>
                <h2 class="font-display text-2xl text-ink mt-2 mb-2">{p.title}</h2>
                <p class="text-sm text-stone">{p.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</Layout>
