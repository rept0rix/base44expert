---
import Layout from '../layouts/Layout.astro'

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'Base44 Expert', item: 'https://base44expert.com/base44-expert' },
  ],
}
---

<Layout
  title="Base44 Expert studio — why we only unstick Base44"
  description="Independent Base44 specialist studio: diagnostic-first unstick for publish, domains, schema, and production. Not a marketplace. Not greenfield builds."
  jsonLd={breadcrumb}
>
  <main id="main">
    <section class="section-padding border-b border-line">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="label-eyebrow mb-2">Studio</p>
        <h1 class="text-4xl sm:text-5xl text-ink mb-6 max-w-3xl text-balance">Why this studio only does Base44 unstick work</h1>
        <p class="text-lg text-stone max-w-2xl leading-relaxed">
          Base44 is powerful and sometimes opaque. We focus on the stuck moments after the vibe-coding rush —
          not on hiring marketplaces or greenfield packages.
        </p>
      </div>
    </section>

    <section class="section-padding" aria-labelledby="tricky-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="tricky-heading" class="text-3xl text-ink mb-10">What makes Base44 tricky</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Entity schemas</h3>
            <p class="text-sm text-stone leading-relaxed">
              Generated schemas move fast until fields drift. Missing records and vague validation usually mean a mismatch, not “random AI.”
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Publish vs live</h3>
            <p class="text-sm text-stone leading-relaxed">
              Success UI with stale live output, failed builds, or blank screens after a change need log isolation — not another prompt.
            </p>
          </div>
          <div class="card-panel">
            <h3 class="font-display text-xl mb-2">Domains &amp; SSL</h3>
            <p class="text-sm text-stone leading-relaxed">
              Works on the Base44 host, fails on yours: DNS, proxy, certificate pending. Complement official docs with hands-on checks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-padding border-t border-line bg-bg-2" aria-labelledby="diff-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="diff-heading" class="text-3xl text-ink mb-6">How we differ</h2>
        <ul class="space-y-4 text-stone max-w-2xl">
          <li><strong class="text-ink">Single studio</strong> — not a vetted marketplace of many freelancers.</li>
          <li><strong class="text-ink">Diagnostic-first</strong> — status, logs, DNS, schema before scoped fix.</li>
          <li><strong class="text-ink">Honest proof</strong> — process and specificity; no invented client logos or rescue counts.</li>
          <li><strong class="text-ink">Official sources cited</strong> — changelog, status, troubleshooting docs.</li>
        </ul>
        <p class="mt-10 flex flex-wrap gap-3">
          <a href="/start" class="btn-primary">Start a diagnostic</a>
          <a href="/work" class="btn-secondary">Process</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
