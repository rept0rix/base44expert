---
import Layout from '../layouts/Layout.astro'
import FaqList from '../components/FaqList.astro'
import { faqCategories, allFaqItems, plainAnswer, faqCount } from '../lib/faq'

const count = faqCount()

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plainAnswer(item.answer),
    },
  })),
}

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://base44expert.com/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://base44expert.com/faq' },
  ],
}
---

<Layout
  title={`Base44 not working? ${count}+ FAQ answers — Base44 Expert`}
  description={`Stuck Base44 FAQ: publish, blank screens, custom domain SSL/DNS, schema, auth, AI edits, connectors, and more — ${count} practical answers from an independent studio. Not affiliated with Base44/Wix.`}
  jsonLd={[faqJsonLd, breadcrumb]}
>
  <main id="main">
    <section class="section-padding page-heat border-b border-line">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl text-ink mb-4 text-balance">
          Stuck on Base44? {count}+ answers
        </h1>
        <p class="text-lg text-stone leading-relaxed mb-6 max-w-2xl">
          Long-tail FAQ for when Base44 is not working — publish, preview vs live, domains &amp; SSL,
          schema, auth, AI edits, blank screens, connectors, and more. Independent studio; we do not
          invent Base44 pricing or claim affiliation.
        </p>
        <label class="block mb-6">
          <span class="font-mono text-[10px] uppercase tracking-wider text-muted mb-2 block">Search this FAQ</span>
          <input
            id="faq-search"
            type="search"
            placeholder="e.g. SSL pending, blank screen, publish success…"
            autocomplete="off"
            class="w-full rounded-xl border border-line bg-bg-2 px-4 py-3 text-ink placeholder:text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
          />
        </label>
        <p id="faq-search-status" class="text-sm text-muted mb-6" aria-live="polite"></p>
        <nav aria-label="FAQ categories" class="flex flex-wrap gap-2 mb-2">
          {faqCategories.map((cat) => (
            <a
              href={`#${cat.id}`}
              class="faq-cat-link inline-flex items-center rounded-full border border-line bg-bg-2 px-3 py-1.5 text-xs font-mono text-muted hover:text-ink hover:border-accent/40 transition-colors"
              data-cat={cat.id}
            >
              {cat.title}
              <span class="ml-1.5 text-muted/80">({cat.items.length})</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="section-padding">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
        {faqCategories.map((cat) => (
          <div class="faq-category" id={cat.id} data-category={cat.id}>
            <h2 class="text-2xl sm:text-3xl text-ink mb-4 scroll-mt-24">{cat.title}</h2>
            <FaqList items={cat.items} idPrefix={cat.id} />
          </div>
        ))}

        <p id="faq-empty" class="hidden text-stone border border-line rounded-xl bg-bg-2 px-4 py-6">
          No questions matched that search. Try fewer words, or
          <a class="underline text-ink" href="/start">start a diagnostic</a>.
        </p>

        <div class="border-t border-line pt-10">
          <p class="text-stone mb-4 leading-relaxed">
            Still stuck after reading? Send a concrete case — URL, timestamp, preview vs live, exact error.
          </p>
          <a href="/start" class="btn-primary magnetic">Start a diagnostic</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById('faq-search');
      const status = document.getElementById('faq-search-status');
      const empty = document.getElementById('faq-empty');
      if (!input) return;

      const categories = Array.from(document.querySelectorAll('.faq-category'));
      const catLinks = Array.from(document.querySelectorAll('.faq-cat-link'));

      const filter = () => {
        const q = (input.value || '').trim().toLowerCase();
        let visibleItems = 0;
        let visibleCats = 0;

        categories.forEach((cat) => {
          const items = cat.querySelectorAll('details');
          let catVisible = 0;
          items.forEach((el) => {
            const text = (el.textContent || '').toLowerCase();
            const show = !q || text.includes(q);
            el.classList.toggle('hidden', !show);
            if (show) {
              catVisible += 1;
              visibleItems += 1;
            }
          });
          const showCat = catVisible > 0;
          cat.classList.toggle('hidden', !showCat);
          if (showCat) visibleCats += 1;
        });

        catLinks.forEach((link) => {
          const id = link.getAttribute('data-cat');
          const cat = id && document.getElementById(id);
          const hide = Boolean(q && cat && cat.classList.contains('hidden'));
          link.classList.toggle('hidden', hide);
        });

        if (empty) empty.classList.toggle('hidden', visibleItems > 0 || !q);
        if (status) {
          status.textContent = q
            ? `${visibleItems} question${visibleItems === 1 ? '' : 's'} in ${visibleCats} categor${visibleCats === 1 ? 'y' : 'ies'}`
            : '';
        }
      };

      input.addEventListener('input', filter, { passive: true });
    })();
  </script>
</Layout>
