---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Process' },
  { href: '/base44-expert', label: 'Expertise' },
  { href: '/contact', label: 'Contact' }
]

const currentPath = Astro.url.pathname
---

<nav class="border-b border-slate-200 bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-0 hover:opacity-80 transition-opacity">
          <img src="/logo.svg" alt="Base44 Expert" class="h-8" />
        </a>
      </div>
      <div class="hidden md:flex md:items-center md:gap-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'text-sm font-medium transition-colors relative',
              currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                ? 'text-teal-700'
                : 'text-slate-700 hover:text-teal-700'
            ]}
          >
            {item.label}
            {(currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))) && (
              <span class="absolute -bottom-[1.4rem] left-0 right-0 h-0.5 bg-teal-700"></span>
            )}
          </a>
        ))}
        <a 
          href="/contact" 
          class="px-5 py-2.5 bg-teal-700 text-white text-sm font-medium rounded-lg hover:bg-teal-800 transition-colors"
        >
          Get Help
        </a>
      </div>
      <div class="md:hidden">
        <button type="button" class="text-slate-700 hover:text-slate-900" id="mobile-menu-button" aria-label="Toggle menu">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div class="md:hidden hidden border-t border-slate-200" id="mobile-menu">
    <div class="px-4 pt-2 pb-4 space-y-1 bg-white">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            'block px-4 py-3 rounded-lg text-base font-medium transition-colors',
            currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
              ? 'bg-teal-50 text-teal-700'
              : 'text-slate-700 hover:bg-slate-50'
          ]}
        >
          {item.label}
        </a>
      ))}
      <a 
        href="/contact" 
        class="block px-4 py-3 mt-2 bg-teal-700 text-white text-base font-medium rounded-lg text-center hover:bg-teal-800 transition-colors"
      >
        Get Help
      </a>
    </div>
  </div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button')
  const menu = document.getElementById('mobile-menu')
  
  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden')
  })
</script>
