---
import { getChangelogItems } from '../lib/changelog'

interface Props {
  limit?: number
  heading?: string
  compact?: boolean
}

const { limit = 5, heading = 'Live Base44 updates', compact = false } = Astro.props
const { items, fromRss, productPage, statusPage } = await getChangelogItems(limit)

function kindLabel(kind: string) {
  return kind === 'developer' ? 'Developer' : 'Product'
}
---

<section class="section-padding border-t border-line" aria-labelledby="changelog-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
      <div>
        <h2 id="changelog-heading" class="text-3xl sm:text-4xl text-ink">{heading}</h2>
      </div>
      <p class="text-sm text-muted max-w-md">
        What’s shipping in Base44 for builders.
        If the platform itself is down, check
        <a class="underline underline-offset-2 text-accent hover:text-accent-2" href={statusPage} rel="noopener noreferrer" target="_blank">status.base44.com</a>.
      </p>
    </div>

    {!fromRss && (
      <p class="text-sm text-muted mb-4 border border-line rounded-xl px-3 py-3 bg-bg-2">
        Feed temporarily unavailable —
        <a class="underline underline-offset-2 text-ink" href={productPage} rel="noopener noreferrer" target="_blank">open the official changelog</a>.
      </p>
    )}

    <ul class="divide-y divide-line border border-line rounded-xl bg-bg-2 overflow-hidden pad-inset" role="list">
      {items.map((item) => (
        <li class="px-3 py-3 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1">
              <span class="inline-flex items-center rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-accent-2">
                {kindLabel(item.kind)}
              </span>
              {item.category && (
                <span class="inline-flex items-center rounded-full border border-line px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-muted">
                  {item.category}
                </span>
              )}
            </div>
            <a
              href={item.link}
              class="text-ink font-medium hover:text-accent transition-colors"
              rel="noopener noreferrer"
              target="_blank"
            >
              {item.title}
            </a>
            {item.summary && (
              <p class="text-sm text-muted mt-1 leading-relaxed">{item.summary}</p>
            )}
          </div>
          {(item.dateLabel || item.date) && (
            <time class="text-xs text-muted font-mono shrink-0" datetime={item.date || undefined}>
              {item.dateLabel || item.date}
            </time>
          )}
        </li>
      ))}
    </ul>

    {!compact && (
      <div class="mt-6 flex flex-wrap gap-4 text-sm">
        <a href="/updates" class="text-accent hover:text-accent-2 underline underline-offset-2">All updates</a>
        <a href={productPage} class="text-muted hover:text-ink underline underline-offset-2" rel="noopener noreferrer" target="_blank">Official changelog</a>
        <a href={statusPage} class="text-muted hover:text-ink underline underline-offset-2" rel="noopener noreferrer" target="_blank">Platform status</a>
        <a href="https://docs.base44.com/Community-and-support/Troubleshooting" class="text-muted hover:text-ink underline underline-offset-2" rel="noopener noreferrer" target="_blank">Docs troubleshooting</a>
      </div>
    )}
  </div>
</section>
