---
const currentYear = new Date().getFullYear()
---

<footer class="border-t border-slate-200 bg-slate-50 mt-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <div class="md:col-span-2">
        <img src="/logo.svg" alt="Base44 Expert" class="h-8 mb-4" />
        <p class="text-sm text-slate-600 leading-relaxed max-w-md">
          A specialist studio that unsticks stuck Base44 apps. We solve publish errors, custom domain issues, and production blockers.
        </p>
      </div>
      <div>
        <h4 class="font-semibold text-slate-900 mb-4 text-sm uppercase tracking-wide">Services</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="/base44-expert" class="text-slate-600 hover:text-teal-700 transition-colors">Base44 Expertise</a></li>
          <li><a href="/base44-not-working" class="text-slate-600 hover:text-teal-700 transition-colors">Troubleshooting Guide</a></li>
          <li><a href="/custom-domains" class="text-slate-600 hover:text-teal-700 transition-colors">Custom Domain Setup</a></li>
          <li><a href="/work" class="text-slate-600 hover:text-teal-700 transition-colors">Our Process</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-slate-900 mb-4 text-sm uppercase tracking-wide">Also By Us</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="https://fixthebase.com" target="_blank" rel="noopener noreferrer" class="text-slate-600 hover:text-teal-700 transition-colors inline-flex items-center gap-1">
              FixTheBase
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <p class="text-xs text-slate-500 mt-1">Base44 web apps</p>
          </li>
          <li><a href="/contact" class="text-slate-600 hover:text-teal-700 transition-colors">Contact Us</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-slate-600">
        &copy; {currentYear} Base44 Expert. All rights reserved.
      </p>
      <p class="text-xs text-slate-500">
        Built by Naor Yanko
      </p>
    </div>
  </div>
</footer>
