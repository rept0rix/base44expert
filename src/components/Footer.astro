    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-semibold text-gray-900 mb-3">Naor Yanko</h3>
        <p class="text-sm text-gray-600">
          Base44 specialist helping teams ship their apps without getting stuck.
        </p>
      </div>
      <div>
        <h4 class="font-semibold text-gray-900 mb-3">Resources</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/base44-expert" class="text-gray-600 hover:text-gray-900">Base44 Expertise</a></li>
          <li><a href="/base44-not-working" class="text-gray-600 hover:text-gray-900">Troubleshooting</a></li>
          <li><a href="/custom-domains" class="text-gray-600 hover:text-gray-900">Custom Domains</a></li>
        </ul>
      </div>
      <div>
        <h4 class="font-semibold text-gray-900 mb-3">Get Started</h4>
