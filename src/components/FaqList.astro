---
import type { FaqItem } from '../lib/faq'

interface Props {
  items: FaqItem[]
  idPrefix?: string
}

const { items, idPrefix = 'faq' } = Astro.props
---

<div class="space-y-3">
  {items.map((item, i) => (
    <details class="group border border-line rounded-lg bg-white open:shadow-sm" id={`${idPrefix}-${i}`}>
      <summary class="cursor-pointer list-none px-5 py-4 flex items-start justify-between gap-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent">
        <span class="font-display text-lg text-ink pr-4">{item.question}</span>
        <span class="text-stone shrink-0 mt-1 font-mono text-sm group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
      </summary>
      <div class="px-5 pb-5 text-stone leading-relaxed prose-studio">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>
