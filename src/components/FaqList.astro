---
import type { FaqItem } from '../lib/faq'

interface Props {
  items: FaqItem[]
  idPrefix?: string
}

const { items, idPrefix = 'faq' } = Astro.props
---

<div class="space-y-3">
  {items.map((item, i) => (
    <details class="group border border-line rounded-xl bg-bg-2 pad-inset open:border-accent/40" id={`${idPrefix}-${i}`}>
      <summary class="cursor-pointer list-none px-3 py-3 flex items-start justify-between gap-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent rounded-xl">
        <span class="font-display text-lg text-ink pr-4">{item.question}</span>
        <span class="text-accent shrink-0 mt-1 font-mono text-sm group-open:rotate-45 transition-transform duration-150" aria-hidden="true">+</span>
      </summary>
      <div class="px-3 pb-3 text-muted leading-relaxed prose-studio">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>
